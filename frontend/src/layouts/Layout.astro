---
import '../styles/global.css';
import GlobalSearch from '../components/GlobalSearch.tsx';
import { ToastContainer } from '../components/Toast.tsx';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg?v=brandimp" />
		<link rel="shortcut icon" type="image/svg+xml" href="/logo.svg?v=brandimp" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=brandimp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} - Brandimp</title>
		<!-- Content Security Policy (CSP) -->
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:8000 https: https://*.supabase.co https://*.sentry.io https://*.ingest.sentry.io;" />
		
		<script is:inline>
			// Guard de autenticación e inyección de tema
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'dark';
			};
			const theme = getThemePreference();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}

			// Verificación inmediata de sesión (basada en existencia de usuario guardado optimísticamente)
			if (typeof window !== 'undefined') {
				const userStr = localStorage.getItem('brandimp_user');
				const hasSession = !!userStr;
				const pathname = window.location.pathname;

				if (!hasSession && pathname !== '/login') {
					window.location.href = '/login';
				} else if (hasSession && pathname === '/login') {
					window.location.href = '/';
				} else if (hasSession) {
					try {
						const user = JSON.parse(localStorage.getItem('brandimp_user') || '{}');
						const rol = user.rol || 'VENDEDOR';

						// Restricciones de rutas por rol
						if (rol === 'OPERARIO' && pathname !== '/pedidos') {
							window.location.href = '/pedidos';
						} else if (rol === 'VENDEDOR' && ['/catalogo', '/usuarios'].includes(pathname)) {
							window.location.href = '/';
						}
					} catch (e) {
						// JSON error
					}
				}
			}
		</script>
	</head>
	<body class="bg-[var(--bg-base)] text-[var(--text-primary)] font-sans min-h-screen flex flex-col md:flex-row transition-colors duration-200">
		
		<!-- Sidebar de Navegación (Solo Desktop >= 768px) -->
		<aside id="sidebar" class="hidden md:flex flex-col justify-between shrink-0 bg-[var(--bg-surface)] border-r border-[var(--border-default)] shadow-sm z-30 transition-all duration-300 w-64">
			<div>
				<!-- Logo y Encabezado del Negocio -->
				<div class="p-6 border-b border-[var(--border-subtle)] flex items-center justify-between">
					<div class="flex items-center gap-3 overflow-hidden">
						<div class="w-10 h-10 rounded-xl bg-[var(--bg-muted)] flex items-center justify-center overflow-hidden shadow-md shrink-0 p-1">
							<img 
								src="/logo.svg" 
								onerror="this.onerror=null; this.src='/logo.webp'; this.onerror=function(){this.src='/logo.png'; this.onerror=null;}" 
								alt="Brandimp Logo" 
								class="w-full h-full object-contain"
							/>
						</div>
						<div id="sidebar-brand-text" class="transition-opacity duration-200 opacity-100">
							<h1 class="font-display font-extrabold text-lg leading-tight tracking-tight text-[var(--text-primary)]">Brandimp</h1>
							<span class="text-[10px] font-bold text-[var(--text-muted)] tracking-wider uppercase">Operaciones</span>
						</div>
					</div>
					<!-- Botón de Colapso del Sidebar -->
					<button id="sidebar-collapse-btn" class="p-1.5 rounded-lg hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer" aria-label="Colapsar menú lateral">
						<svg id="collapse-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300"><polyline points="11 17 6 12 11 7"></polyline><polyline points="18 17 13 12 18 7"></polyline></svg>
					</button>
				</div>

				<!-- Links de Navegación Principal -->
				<nav class="p-4 space-y-1" aria-label="Navegación principal">
					<a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] [&.active]:bg-[var(--bg-muted)] [&.active]:text-[#59BFCB] [&.active]:font-semibold" id="nav-dashboard" data-roles="ADMIN,VENDEDOR">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg>
						<span class="sidebar-link-text transition-opacity duration-200">Dashboard</span>
					</a>
					<a href="/pedidos" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] [&.active]:bg-[var(--bg-muted)] [&.active]:text-[#59BFCB] [&.active]:font-semibold" id="nav-pedidos" data-roles="ADMIN,VENDEDOR,OPERARIO">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect><path d="M9 14l2 2 4-4"></path></svg>
						<span class="sidebar-link-text transition-opacity duration-200">Pedidos</span>
					</a>
					<a href="/nuevo-pedido" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] [&.active]:bg-[var(--bg-muted)] [&.active]:text-[#59BFCB] [&.active]:font-semibold" id="nav-nuevo" data-roles="ADMIN,VENDEDOR">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
						<span class="sidebar-link-text transition-opacity duration-200">Nuevo Pedido</span>
					</a>
					<a href="/marcas" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] [&.active]:bg-[var(--bg-muted)] [&.active]:text-[#59BFCB] [&.active]:font-semibold" id="nav-marcas" data-roles="ADMIN,VENDEDOR">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
						<span class="sidebar-link-text transition-opacity duration-200">Marcas & Historial</span>
					</a>
					<a href="/catalogo" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] [&.active]:bg-[var(--bg-muted)] [&.active]:text-[#59BFCB] [&.active]:font-semibold" id="nav-catalogo" data-roles="ADMIN">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
						<span class="sidebar-link-text transition-opacity duration-200">Catálogo</span>
					</a>
					<a href="/cuentas-por-cobrar" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] [&.active]:bg-[var(--bg-muted)] [&.active]:text-[#59BFCB] [&.active]:font-semibold" id="nav-cuentas" data-roles="ADMIN,VENDEDOR">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
						<span class="sidebar-link-text transition-opacity duration-200">Cuentas por Cobrar</span>
					</a>
					<a href="/usuarios" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] [&.active]:bg-[var(--bg-muted)] [&.active]:text-[#59BFCB] [&.active]:font-semibold" id="nav-usuarios" data-roles="ADMIN">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
						<span class="sidebar-link-text transition-opacity duration-200">Usuarios & Roles</span>
					</a>
				</nav>
			</div>

			<!-- Footer del Sidebar -->
			<div class="p-4 border-t border-[var(--border-subtle)] space-y-3 bg-[var(--bg-surface-raised)]">
				<button id="theme-toggle" class="w-full flex items-center justify-center gap-2 py-2 px-4 rounded-xl border border-[var(--border-default)] bg-[var(--bg-surface)] hover:bg-[var(--bg-muted)] font-medium text-sm shadow-xs transition-all cursor-pointer text-[var(--text-primary)]" aria-label="Cambiar tema de pantalla">
					<span class="theme-icon-light hidden dark:flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
						<span class="sidebar-link-text">Modo Claro</span>
					</span>
					<span class="theme-icon-dark flex dark:hidden items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
						<span class="sidebar-link-text">Modo Oscuro</span>
					</span>
				</button>
				
				<div className="pt-2 border-t border-[var(--border-subtle)] space-y-2">
					<div class="flex items-center gap-3 px-2">
						<div id="user-avatar-initial" class="w-9 h-9 rounded-full bg-gradient-to-br from-[#59BFCB] to-[#9478B3] flex items-center justify-center font-bold text-white shadow-xs shrink-0 text-sm">
							U
						</div>
						<div id="sidebar-user-text" class="transition-opacity duration-200 opacity-100 min-w-0 flex-1">
							<p id="user-display-name" class="text-xs font-semibold leading-tight text-[var(--text-primary)] truncate">Usuario</p>
							<p id="user-display-role" class="text-[10px] text-[var(--text-muted)] truncate font-medium">Cargando...</p>
						</div>
					</div>

					<button id="logout-btn" class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs font-bold text-rose-400 hover:bg-rose-500/10 transition-all cursor-pointer">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
						<span class="sidebar-link-text">Cerrar Sesión</span>
					</button>
				</div>
			</div>
		</aside>

		<!-- Bottom Navigation Bar (Solo Móvil < 768px - Max 5 ítems ergonómicos) -->
		<nav class="md:hidden fixed bottom-0 left-0 right-0 h-16 bg-[var(--bg-surface)] border-t border-[var(--border-default)] shadow-lg z-40 flex items-center justify-around px-1" aria-label="Navegación móvil">
			<a href="/" class="flex flex-col items-center justify-center flex-1 h-full py-1 text-[var(--text-secondary)] hover:text-[#59BFCB] [&.active]:text-[#59BFCB] transition-colors" id="mobile-nav-dashboard" data-roles="ADMIN,VENDEDOR">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg>
				<span class="text-[10px] font-semibold mt-1">Inicio</span>
			</a>
			<a href="/pedidos" class="flex flex-col items-center justify-center flex-1 h-full py-1 text-[var(--text-secondary)] hover:text-[#59BFCB] [&.active]:text-[#59BFCB] transition-colors" id="mobile-nav-pedidos" data-roles="ADMIN,VENDEDOR,OPERARIO">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect><path d="M9 14l2 2 4-4"></path></svg>
				<span class="text-[10px] font-semibold mt-1">Pedidos</span>
			</a>
			<a href="/nuevo-pedido" class="flex flex-col items-center justify-center flex-1 h-full py-1 text-[var(--text-secondary)] hover:text-[#59BFCB] [&.active]:text-[#59BFCB] transition-colors" id="mobile-nav-nuevo" data-roles="ADMIN,VENDEDOR">
				<div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#59BFCB] to-[#9478B3] flex items-center justify-center text-white shadow-md">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
				</div>
				<span class="text-[9px] font-bold text-[#59BFCB] mt-0.5">Nuevo</span>
			</a>
			<a href="/marcas" class="flex flex-col items-center justify-center flex-1 h-full py-1 text-[var(--text-secondary)] hover:text-[#59BFCB] [&.active]:text-[#59BFCB] transition-colors" id="mobile-nav-marcas" data-roles="ADMIN,VENDEDOR">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
				<span class="text-[10px] font-semibold mt-1">Marcas</span>
			</a>
			<button id="mobile-menu-toggle-btn" class="flex flex-col items-center justify-center flex-1 h-full py-1 text-[var(--text-secondary)] hover:text-[#59BFCB] transition-colors cursor-pointer" aria-label="Abrir menú de usuario">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
				<span class="text-[10px] font-semibold mt-1">Menú</span>
			</button>
		</nav>

		<!-- Mobile Slide-Over Menu Drawer (Solo Móvil) -->
		<div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden transition-opacity duration-300"></div>
		<div id="mobile-drawer" class="fixed bottom-0 left-0 right-0 max-h-[85vh] bg-[var(--bg-surface)] border-t border-[var(--border-default)] rounded-t-3xl shadow-2xl z-50 transform translate-y-full transition-transform duration-300 overflow-y-auto p-6 space-y-6">
			<!-- Header del Drawer -->
			<div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4">
				<div class="flex items-center gap-3">
					<div id="mobile-user-avatar" class="w-10 h-10 rounded-full bg-gradient-to-br from-[#59BFCB] to-[#9478B3] flex items-center justify-center font-bold text-white shadow-xs text-sm">
						U
					</div>
					<div>
						<p id="mobile-user-name" class="text-sm font-bold text-[var(--text-primary)]">Usuario</p>
						<span id="mobile-user-role" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#59BFCB]/10 text-[#59BFCB] border border-[#59BFCB]/30">
							Cargando...
						</span>
					</div>
				</div>
				<button id="mobile-drawer-close" class="p-2 rounded-xl hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] cursor-pointer">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
				</button>
			</div>

			<!-- Secciones Rápidas del Drawer -->
			<div class="space-y-2">
				<h3 class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider">Módulos del Sistema</h3>
				<a href="/catalogo" class="flex items-center justify-between p-3 rounded-2xl bg-[var(--bg-surface-raised)] border border-[var(--border-default)] text-xs font-bold text-[var(--text-primary)]" data-roles="ADMIN">
					<span class="flex items-center gap-2.5">📁 Catálogo y Precios</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
				</a>
				<a href="/cuentas-por-cobrar" class="flex items-center justify-between p-3 rounded-2xl bg-[var(--bg-surface-raised)] border border-[var(--border-default)] text-xs font-bold text-[var(--text-primary)]" data-roles="ADMIN,VENDEDOR">
					<span class="flex items-center gap-2.5">💳 Cuentas por Cobrar</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
				</a>
				<a href="/usuarios" class="flex items-center justify-between p-3 rounded-2xl bg-[var(--bg-surface-raised)] border border-[var(--border-default)] text-xs font-bold text-[var(--text-primary)]" data-roles="ADMIN">
					<span class="flex items-center gap-2.5">👥 Usuarios & Roles</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
				</a>
			</div>

			<!-- Preferencias y Cierre de Sesión -->
			<div class="space-y-3 pt-2 border-t border-[var(--border-subtle)]">
				<button id="mobile-theme-toggle" class="w-full flex items-center justify-between p-3 rounded-2xl bg-[var(--bg-muted)] text-xs font-bold text-[var(--text-primary)] cursor-pointer">
					<span class="flex items-center gap-2">🎨 Tema Visual</span>
					<span class="text-[11px] text-[var(--text-secondary)] font-semibold flex items-center gap-1">
						Cambiar Tema 🌙/☀️
					</span>
				</button>

				<button id="mobile-logout-btn" class="w-full py-3 rounded-2xl bg-rose-500/10 text-rose-400 font-bold text-xs border border-rose-500/30 flex items-center justify-center gap-2 cursor-pointer hover:bg-rose-500/20 transition-all">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
					<span>Cerrar Sesión</span>
				</button>
			</div>
		</div>

		<!-- Contenedor Principal de Contenido -->
		<main class="flex-1 min-w-0 flex flex-col pb-16 md:pb-0">
			<!-- Header superior -->
			<header class="h-16 px-4 md:px-8 border-b border-[var(--border-default)] flex items-center justify-between gap-3 bg-[var(--bg-surface)] shadow-xs shrink-0 z-20">
				<!-- Título de Página en Desktop / Logo Móvil -->
				<div class="flex items-center gap-2 shrink-0">
					<h2 class="font-display text-sm font-bold tracking-wider text-[var(--text-secondary)] uppercase shrink-0 hidden sm:block">
						{title}
					</h2>
					<div class="flex sm:hidden items-center gap-2">
						<div class="w-8 h-8 rounded-lg bg-[var(--bg-muted)] flex items-center justify-center p-1">
							<img src="/logo.svg" onerror="this.onerror=null; this.src='/logo.png';" alt="Brandimp" class="w-full h-full object-contain" />
						</div>
					</div>
				</div>

				<!-- Buscador Global -->
				<div class="flex-1 max-w-xs md:max-w-sm">
					<GlobalSearch client:load />
				</div>
				
				<!-- Estado de Conexión API / Rol Badge en Desktop / Avatar en Móvil -->
				<div class="flex items-center gap-3 shrink-0">
					<span id="header-role-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-[#59BFCB]/10 text-[#59BFCB] border border-[#59BFCB]/30 hidden sm:inline-block">
						Cargando...
					</span>
					<div class="hidden md:flex items-center gap-2 border-l border-[var(--border-subtle)] pl-3">
						<span class="flex h-2.5 w-2.5 relative">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#59BFCB] opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#59BFCB]"></span>
						</span>
						<span class="text-xs font-semibold text-[var(--text-secondary)]">API Online</span>
					</div>
					<!-- Botón de Menú Móvil en Header -->
					<button id="header-mobile-menu-btn" class="sm:hidden w-8 h-8 rounded-full bg-gradient-to-br from-[#59BFCB] to-[#9478B3] flex items-center justify-center text-white font-bold text-xs shadow-xs cursor-pointer">
						<span id="header-mobile-avatar">U</span>
					</button>
				</div>
			</header>

			<!-- Contenido de la Página con scroll independiente -->
			<div class="flex-1 overflow-y-auto p-4 sm:p-6 md:p-8">
				<slot />
			</div>
		</main>

		<script>
			// Filtrado dinámico de navegación por rol y renderizado de usuario
			const rawUser = localStorage.getItem('brandimp_user');
			const user = rawUser ? JSON.parse(rawUser) : null;
			const userRole = user?.rol || 'VENDEDOR';

			// Actualizar UI del usuario logueado
			const nameEl = document.getElementById('user-display-name');
			const roleEl = document.getElementById('user-display-role');
			const avatarEl = document.getElementById('user-avatar-initial');
			const headerBadgeEl = document.getElementById('header-role-badge');
			const mobileNameEl = document.getElementById('mobile-user-name');
			const mobileRoleEl = document.getElementById('mobile-user-role');
			const mobileAvatarEl = document.getElementById('mobile-user-avatar');
			const headerMobileAvatarEl = document.getElementById('header-mobile-avatar');

			if (user) {
				const displayName = user.nombre_completo || user.username;
				const displayRole = user.rol_display || userRole;
				const initial = displayName.charAt(0).toUpperCase();

				if (nameEl) nameEl.textContent = displayName;
				if (roleEl) roleEl.textContent = displayRole;
				if (avatarEl) avatarEl.textContent = initial;
				if (headerBadgeEl) headerBadgeEl.textContent = displayRole;

				if (mobileNameEl) mobileNameEl.textContent = displayName;
				if (mobileRoleEl) mobileRoleEl.textContent = displayRole;
				if (mobileAvatarEl) mobileAvatarEl.textContent = initial;
				if (headerMobileAvatarEl) headerMobileAvatarEl.textContent = initial;
			}

			// Filtrar visibilidad de links por rol
			document.querySelectorAll('[data-roles]').forEach(el => {
				const allowedRoles = (el.getAttribute('data-roles') || '').split(',');
				if (!allowedRoles.includes(userRole)) {
					(el as HTMLElement).style.display = 'none';
				}
			});

			// Control dinámico de clase active en sidebar y mobile nav
			const pathname = window.location.pathname;
			const navIds = {
				'/': ['nav-dashboard', 'mobile-nav-dashboard'],
				'/pedidos': ['nav-pedidos', 'mobile-nav-pedidos'],
				'/nuevo-pedido': ['nav-nuevo', 'mobile-nav-nuevo'],
				'/marcas': ['nav-marcas', 'mobile-nav-marcas'],
				'/catalogo': ['nav-catalogo'],
				'/cuentas-por-cobrar': ['nav-cuentas'],
				'/usuarios': ['nav-usuarios']
			};
			const activeIds = navIds[pathname] || [];
			activeIds.forEach(id => {
				const activeEl = document.getElementById(id);
				if (activeEl) activeEl.classList.add('active');
			});

			// Lógica del drawer móvil
			const mobileDrawer = document.getElementById('mobile-drawer');
			const mobileDrawerBackdrop = document.getElementById('mobile-drawer-backdrop');
			const mobileMenuToggleBtn = document.getElementById('mobile-menu-toggle-btn');
			const headerMobileMenuBtn = document.getElementById('header-mobile-menu-btn');
			const mobileDrawerClose = document.getElementById('mobile-drawer-close');

			const openMobileDrawer = () => {
				if (mobileDrawer && mobileDrawerBackdrop) {
					mobileDrawerBackdrop.classList.remove('hidden');
					mobileDrawer.classList.remove('translate-y-full');
				}
			};

			const closeMobileDrawer = () => {
				if (mobileDrawer && mobileDrawerBackdrop) {
					mobileDrawer.classList.add('translate-y-full');
					setTimeout(() => {
						mobileDrawerBackdrop.classList.add('hidden');
					}, 200);
				}
			};

			mobileMenuToggleBtn?.addEventListener('click', openMobileDrawer);
			headerMobileMenuBtn?.addEventListener('click', openMobileDrawer);
			mobileDrawerClose?.addEventListener('click', closeMobileDrawer);
			mobileDrawerBackdrop?.addEventListener('click', closeMobileDrawer);

			// Lógica del sidebar colapsable en desktop
			const sidebar = document.getElementById('sidebar');
			const collapseBtn = document.getElementById('sidebar-collapse-btn');
			const collapseIcon = document.getElementById('collapse-icon');
			const brandText = document.getElementById('sidebar-brand-text');
			const userText = document.getElementById('sidebar-user-text');
			const linkTexts = document.querySelectorAll('.sidebar-link-text');

			let isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';

			const applySidebarState = (collapsed: boolean) => {
				if (sidebar) {
					if (collapsed) {
						sidebar.classList.remove('w-64');
						sidebar.classList.add('w-20');
						if (brandText) brandText.style.display = 'none';
						if (userText) userText.style.display = 'none';
						linkTexts.forEach(el => (el as HTMLElement).style.display = 'none');
						if (collapseIcon) collapseIcon.style.transform = 'rotate(180deg)';
					} else {
						sidebar.classList.remove('w-20');
						sidebar.classList.add('w-64');
						setTimeout(() => {
							if (!isCollapsed) {
								if (brandText) brandText.style.display = 'block';
								if (userText) userText.style.display = 'block';
								linkTexts.forEach(el => (el as HTMLElement).style.display = 'inline');
							}
						}, 150);
						if (collapseIcon) collapseIcon.style.transform = 'rotate(0deg)';
					}
				}
			};

			applySidebarState(isCollapsed);

			collapseBtn?.addEventListener('click', () => {
				isCollapsed = !isCollapsed;
				localStorage.setItem('sidebar-collapsed', String(isCollapsed));
				applySidebarState(isCollapsed);
			});

			// Tema claro/oscuro
			const toggleBtn = document.getElementById('theme-toggle');
			const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

			const toggleTheme = () => {
				const element = document.documentElement;
				element.classList.toggle('dark');
				const isDark = element.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			};

			toggleBtn?.addEventListener('click', toggleTheme);
			mobileThemeToggle?.addEventListener('click', toggleTheme);

			// Handler de Cerrar Sesión
			const logoutBtn = document.getElementById('logout-btn');
			const mobileLogoutBtn = document.getElementById('mobile-logout-btn');

			const handleLogout = async () => {
				try {
					const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000/api';
					await fetch(`${apiUrl}/auth/logout/`, {
						method: 'POST',
						credentials: 'include'
					});
				} catch(e) {} // Ignorar errores de red
				localStorage.removeItem('brandimp_user');
				window.location.href = '/login';
			};

			logoutBtn?.addEventListener('click', handleLogout);
			mobileLogoutBtn?.addEventListener('click', handleLogout);
		</script>
		<ToastContainer client:load />
	</body>
</html>
